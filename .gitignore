__pycache__/
*.pyc
.pytest_cache/

# Base de datos y backups locales — nunca versionar datos de usuarios reales
*.db
*.db.backup

# Logs
*.log

# Empaquetados manuales — usar tags/releases de git en su lugar, no zips sueltos
*.zip

# Archivos de trabajo tipo "copy" que no deberían llegar a main
*copy*.py
* copy.py

# Proyectos de usuario (imágenes, máscaras, resultados, .sombra) —
# datos de trabajo locales, no código
proyectos/

# Configuración y datos locales del usuario. settings.json se regenera
# con valores por defecto si no existe (SettingsManager.load) y guarda
# rutas absolutas locales (last_project_path) — no hay nada que
# versionar. Las máscaras son datos de trabajo del usuario.
data/settings.json
# Base de especies editada por el usuario (se regenera desde core/species.py)
data/species_db.json
mascaras.json
mascarascoco.json
